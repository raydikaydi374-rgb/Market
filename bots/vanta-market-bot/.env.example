# Discord Developer Portal > Bot > Reset Token (keep this value private)
DISCORD_TOKEN=

# Discord Developer Portal > General Information > Application ID
CLIENT_ID=

# Server and channel/role IDs; enable Developer Mode in Discord to copy IDs.
GUILD_ID=
# Optional first administrator role; managed roles are also stored in SQLite.
STAFF_ROLE_ID=
ORDERS_CHANNEL_ID=
TICKET_CATEGORY_ID=
# Optional initial notification member; changeable with /setmentionuser.
ORDER_NOTIFY_USER_ID=
# Optional; alternatively configure in Discord with /setowner.
OWNER_ID=
# Optional; alternatively configure in Discord with /setpaymentwallet.
LTC_WALLET_ADDRESS=

# Optional. Relative paths are resolved from this bot folder.
DATABASE_PATH=./data/vanta-market.sqlite
