modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
CLIENT_ID = "1564744169904279613"
GUILD_ID = "1564357450771988503"
STAFF_ROLE_ID = "1564358072120512713"
ORDERS_CHANNEL_ID = "1564750524639744160"
TICKET_CATEGORY_ID = "1564918984778846268"

[nix]
channel = "stable-25_05"
